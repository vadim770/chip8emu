{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build project",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                   "-fdiagnostics-color=always",
                   "-std=c++20", 
                   "-g",
                   "-Wall",
                   "-Wextra",
                   "-Wpedantic",
                   "-Wshadow",
                   "-Wconversion",
                   "-Werror", // Remove/comment this out if you don't want warnings to block compilation
                   "-DSDL_MAIN_HANDLED",
                   "${workspaceFolder}/src/*.cpp",
                   "-o",
                   "${workspaceFolder}/src/chip8emu.exe",
                   "-lSDL3"
               ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Project build task."
        }
    ],
    "version": "2.0.0"
}